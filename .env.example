# Copy to .env and fill in. NEVER commit .env.

# Deployer key (Shannon testnet account with STT from a faucet)
PRIVATE_KEY=0x...

# Somnia Shannon testnet RPC (chain 50312)
SHANNON_RPC=https://api.infra.testnet.somnia.network/

# LLM Inference base-agent id - get the real value from https://agents.somnia.network
LLM_AGENT_ID=

# Optional overrides
# SOMNIA_PLATFORM=0x037Bb9C718F3f7fe5eCBDB0b600D607b52706776   # testnet AgentRequester (default)
# TREASURY=0x...                                                # slashed-stake cut recipient (defaults to deployer)
